# Build outputs
zig-out/
.zig-cache/
.zig-global-cache/
# Release packaging output. scripts/package_release.sh writes the archive and
# its checksum file into the tree it is run from; the release workflow publishes
# them as release assets, so committing a copy of either only risks shipping a
# stale build.
*.zip
release/
*.o
*.dll
*.lib
*.pdb
*.exe
*.so

# Logs and traces
*.log

# Debug/temp artifacts
.scratch/
.scratch_*
# Python bytecode: the scripts/*.py gates are run in place, and an interpreter
# writes a cache next to each of them the first time it imports one.
__pycache__/
*.pyc
europa_dump.txt
exports.txt
targets.txt
loop.txt
root.o
file_access.log
file_trace*.log
full_trace.log
trace*.log
wine_crash.log

# Test media (large binary files, provide your own)
test_media/

# Closed-source proprietary plugins (NOT distributable)
plugins/
*.asi
*.AS6
*.m3d
*.flt

# Copyrighted reference materials (NOT distributable)
references/

# Game directories (test data — NOT part of the project)
Guild/
test_games/

# Tool directories
.claude/

# OS files
.DS_Store
Thumbs.db
